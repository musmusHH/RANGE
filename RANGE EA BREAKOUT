void GetPerformanceStatistics(int &trades,
                              int &wins,
                              int &losses,
                              double &netProfit,
                              double &grossProfit,
                              double &grossLoss,
                              double &totalLots,
                              double &averageWin,
                              double &averageLoss)
{
   trades = 0; wins = 0; losses = 0;
   netProfit = 0.0; grossProfit = 0.0; grossLoss = 0.0;
   totalLots = 0.0; averageWin = 0.0; averageLoss = 0.0;
   for(int i = OrdersHistoryTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY)) continue;
      if(OrderMagicNumber() != MagicNumber) continue;
      if(!TrackerAllSymbolsWithMagic && OrderSymbol() != Symbol()) continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL) continue;
      double result = OrderProfit() + OrderSwap() + OrderCommission();
      trades++;
      totalLots += OrderLots();
      netProfit += result;
      if(result > 0.0) { wins++; grossProfit += result; }
      else { losses++; grossLoss += result; }
   }
   if(wins > 0) averageWin = grossProfit / wins;
   if(losses > 0) averageLoss = grossLoss / losses;
}

void DrawLastTradeStrip(const int x,
                        const int y,
                        const int maximumTrades)
{
   int drawn = 0;
   for(int i = OrdersHistoryTotal() - 1; i >= 0 && drawn < maximumTrades; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY)) continue;
      if(OrderMagicNumber() != MagicNumber) continue;
      if(!TrackerAllSymbolsWithMagic && OrderSymbol() != Symbol()) continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL) continue;
      double result = OrderProfit() + OrderSwap() + OrderCommission();
      color boxColor = result > 0.0 ? SuccessColor : FailureColor;
      SetScreenRectangle(g_objectPrefix + "LAST_BOX_" + IntegerToString(drawn),
                         x + drawn * 17, y, 13, 8,
                         boxColor, boxColor, 6);
      drawn++;
   }
   for(int j = drawn; j < maximumTrades; j++)
      DeleteObjectIfExists(g_objectPrefix + "LAST_BOX_" + IntegerToString(j));
}

void DrawClosedTradeResultCards()
{
   int historyCount = OrdersHistoryTotal();
   if(historyCount == g_lastResultCardHistoryCount)
      return;
   g_lastResultCardHistoryCount = historyCount;

   string cardPrefix = g_objectPrefix + "TRADE_CARD_";
   DeleteObjectsWithPrefix(cardPrefix);

   long chartWidth = 0;
   long chartHeight = 0;
   ChartGetInteger(0, CHART_WIDTH_IN_PIXELS, 0, chartWidth);
   ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS, 0, chartHeight);
   if(chartWidth < 300 || chartHeight < 180)
   {
      g_lastResultCardHistoryCount = -1;
      return;
   }

   int cardWidth = ClosedTradeCardWidth;
   int cardHeight = ClosedTradeCardHeight;
   int leftLimit = 6;
   if(ShowEAStatus)
      leftLimit = DashboardX + 400 + 10;
   int rightLimit = (int)chartWidth - 6;
   if(ShowProfitTracker)
   {
      int trackerMargin = ProfitTrackerRightMargin;
      if(trackerMargin < 5) trackerMargin = 5;
      if(trackerMargin > 160) trackerMargin = 160;
      rightLimit = (int)chartWidth - trackerMargin - 395 - 10;
   }
   if(rightLimit - leftLimit < cardWidth)
      return;

   int usedX[];
   int usedY[];
   int drawn = 0;

   // Draw every matching closed trade whose close point is currently visible
   // in the center chart area. Scrolling/zooming triggers a complete redraw.
   for(int i = historyCount - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;
      if(OrderCloseTime() <= 0)
         continue;

      int anchorX = 0;
      int anchorY = 0;
      if(!ChartTimePriceToXY(0, 0, OrderCloseTime(), OrderClosePrice(),
                             anchorX, anchorY))
         continue;
      if(anchorX < leftLimit || anchorX > rightLimit ||
         anchorY < 0 || anchorY >= (int)chartHeight)
         continue;

      int cardX = anchorX - cardWidth / 2;
      if(cardX < leftLimit) cardX = leftLimit;
      if(cardX + cardWidth > rightLimit) cardX = rightLimit - cardWidth;
      int baseY = anchorY + ClosedTradeCardOffsetY;
      if(baseY + cardHeight > (int)chartHeight - 5)
         baseY = anchorY - cardHeight - ClosedTradeCardOffsetY;
      if(baseY < 5) baseY = 5;

      int cardY = baseY;
      bool placed = false;
      for(int attempt = 0; attempt < 14; attempt++)
      {
         if(attempt > 0)
         {
            int level = (attempt + 1) / 2;
            int direction = (attempt % 2 == 1) ? 1 : -1;
            cardY = baseY + direction * level * (cardHeight + 5);
            if(cardY < 5) cardY = 5;
            if(cardY + cardHeight > (int)chartHeight - 5)
               cardY = (int)chartHeight - cardHeight - 5;
         }

         bool overlap = false;
         for(int r = 0; r < drawn; r++)
         {
            if(cardX < usedX[r] + cardWidth + 4 &&
               cardX + cardWidth + 4 > usedX[r] &&
               cardY < usedY[r] + cardHeight + 4 &&
               cardY + cardHeight + 4 > usedY[r])
            {
               overlap = true;
               break;
            }
         }
         if(!overlap)
         {
            placed = true;
            break;
         }
      }
      // When a very crowded chart has no free slot, retain the card at its
      // close-point position rather than hiding a requested trade result.
      if(!placed) cardY = baseY;

      double netResult = OrderProfit() + OrderSwap() + OrderCommission();
      double pointResult = OrderType() == OP_BUY
                           ? (OrderClosePrice() - OrderOpenPrice()) / Point
                           : (OrderOpenPrice() - OrderClosePrice()) / Point;
      int roundedPoints = (int)MathRound(pointResult);
      string outcome = netResult > 0.0 ? "WIN"
                       : (netResult < 0.0 ? "LOSS" : "FLAT");
      string title = outcome + "  " + SignedNumber(netResult, 2);
      string detail = (OrderType() == OP_BUY ? "BUY " : "SELL ")
                      + DoubleToString(OrderLots(), LotDigits()) + "  "
                      + (roundedPoints > 0 ? "+" : "")
                      + IntegerToString(roundedPoints) + " pts";
      color cardColor = netResult >= 0.0
                        ? g_styleWinCard : g_styleLossCard;
      string base = cardPrefix + IntegerToString(OrderTicket());

      SetScreenRectangle(base + "_SHADOW", cardX + 4, cardY + 5,
                         cardWidth, cardHeight,
                         BlendColor(clrBlack, g_styleBody, 0.88),
                         BlendColor(clrBlack, g_styleBody, 0.88), 6);
      SetScreenRectangle(base + "_BODY", cardX, cardY,
                         cardWidth, cardHeight,
                         BlendColor(cardColor, g_styleBody, 0.72),
                         BlendColor(clrWhite, cardColor, 0.38), 7);
      SetScreenRectangle(base + "_HEAD", cardX + 2, cardY + 2,
                         cardWidth - 4, 21,
                         cardColor, cardColor, 8);
      SetScreenRectangle(base + "_DOT", anchorX - 2, anchorY - 2,
                         5, 5, cardColor, clrWhite, 9);
      SetCardLabel(base + "_TITLE", cardX + 8, cardY + 4,
                   title, clrWhite, 10, true);
      SetCardLabel(base + "_DETAIL", cardX + 8, cardY + 26,
                   detail, clrWhite, 7, true);
      ObjectSetInteger(0, base + "_TITLE", OBJPROP_ZORDER, 10);
      ObjectSetInteger(0, base + "_DETAIL", OBJPROP_ZORDER, 10);

      ArrayResize(usedX, drawn + 1);
      ArrayResize(usedY, drawn + 1);
      usedX[drawn] = cardX;
      usedY[drawn] = cardY;
      drawn++;
   }
}

void DrawProfitTrackerCard()
{
   if(!ShowProfitTracker || !VisualOutputAvailable())
      return;

   int currentHistoryCount = OrdersHistoryTotal();
   int currentDayKey = BrokerDayKey(TimeCurrent());
   if(currentHistoryCount == g_lastTrackerHistoryCount &&
      currentDayKey == g_lastTrackerDayKey)
      return;
   g_lastTrackerHistoryCount = currentHistoryCount;
   g_lastTrackerDayKey = currentDayKey;

   int days = ProfitTrackerDays;
   if(days < 1) days = 1;
   if(days > 60) days = 60;

   double dayLots[];
   double dayProfit[];
   int dayTrades[];
   int dayWins[];
   int dayLosses[];
   ArrayResize(dayLots, days);
   ArrayResize(dayProfit, days);
   ArrayResize(dayTrades, days);
   ArrayResize(dayWins, days);
   ArrayResize(dayLosses, days);
   ArrayInitialize(dayLots, 0.0);
   ArrayInitialize(dayProfit, 0.0);
   ArrayInitialize(dayTrades, 0);
   ArrayInitialize(dayWins, 0);
   ArrayInitialize(dayLosses, 0);

   datetime todayStart = BrokerDayStart(TimeCurrent());
   datetime weeklyStart = todayStart - 6 * 86400;
   datetime monthlyStart = todayStart - 29 * 86400;
   MqlDateTime calendarParts;
   TimeToStruct(todayStart, calendarParts);
   int sinceMonday = (calendarParts.day_of_week + 6) % 7;
   datetime thisWeekStart = todayStart - sinceMonday * 86400;
   calendarParts.day = 1;
   datetime thisMonthStart = StructToTime(calendarParts);

   int weeklyTrades = 0, weeklyWins = 0, weeklyLosses = 0;
   double weeklyProfit = 0.0, weeklyLots = 0.0;
   int monthlyTrades = 0, monthlyWins = 0, monthlyLosses = 0;
   double monthlyProfit = 0.0, monthlyLots = 0.0;
   int thisWeekTrades = 0, thisWeekWins = 0, thisWeekLosses = 0;
   double thisWeekProfit = 0.0, thisWeekLots = 0.0;
   int thisMonthTrades = 0, thisMonthWins = 0, thisMonthLosses = 0;
   double thisMonthProfit = 0.0, thisMonthLots = 0.0;
   int totalTrades = 0, totalWins = 0, totalLosses = 0;
   double totalProfit = 0.0, totalLots = 0.0;

   for(int h = OrdersHistoryTotal() - 1; h >= 0; h--)
   {
      if(!OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      if(!TrackerAllSymbolsWithMagic && OrderSymbol() != Symbol())
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;

      datetime closeTime = OrderCloseTime();
      double result = OrderProfit() + OrderSwap() + OrderCommission();
      bool win = (result > 0.0);

      totalTrades++;
      totalProfit += result;
      totalLots += OrderLots();
      if(win) totalWins++; else totalLosses++;

      if(closeTime >= weeklyStart)
      {
         weeklyTrades++;
         weeklyProfit += result;
         weeklyLots += OrderLots();
         if(win) weeklyWins++; else weeklyLosses++;
      }
      if(closeTime >= monthlyStart)
      {
         monthlyTrades++;
         monthlyProfit += result;
         monthlyLots += OrderLots();
         if(win) monthlyWins++; else monthlyLosses++;
      }
      if(closeTime >= thisWeekStart)
      {
         thisWeekTrades++;
         thisWeekProfit += result;
         thisWeekLots += OrderLots();
         if(win) thisWeekWins++; else thisWeekLosses++;
      }
      if(closeTime >= thisMonthStart)
      {
         thisMonthTrades++;
         thisMonthProfit += result;
         thisMonthLots += OrderLots();
         if(win) thisMonthWins++; else thisMonthLosses++;
      }

      for(int d = 0; d < days; d++)
      {
         datetime dayStart = todayStart - d * 86400;
         datetime dayEnd = dayStart + 86400;
         if(closeTime >= dayStart && closeTime < dayEnd)
         {
            dayLots[d] += OrderLots();
            dayProfit[d] += result;
            dayTrades[d]++;
            if(win) dayWins[d]++; else dayLosses[d]++;
            break;
         }
      }
   }

   // Always show today, then only historical dates containing closed trades.
   // The row cap adapts to the selected header/font sizes so all six analysis
   // lines always remain inside the fixed 610-pixel panel.
   int headerHeight = ProfitTrackerHeaderHeight;
   int trackerFont = ProfitTrackerFontSize;
   int rowHeight = trackerFont + 4;
   int analysisSpacing = trackerFont + 9;
   int maximumDailyRows = (610 - headerHeight - 105
                           - 5 * analysisSpacing - trackerFont) / rowHeight;
   if(maximumDailyRows < 1) maximumDailyRows = 1;
   if(maximumDailyRows > 30) maximumDailyRows = 30;
   int displayedRows = 1;
   for(int activeDay = 1; activeDay < days; activeDay++)
   {
      if(dayTrades[activeDay] > 0 && displayedRows < maximumDailyRows)
         displayedRows++;
   }

   // 440 - 45 = 395 pixels, as requested.
   int panelWidth = 395;
   int rightMargin = ProfitTrackerRightMargin;
   if(rightMargin < 5) rightMargin = 5;
   if(rightMargin > 160) rightMargin = 160;
   int y = ProfitTrackerY;
   long chartWidthPixels = 0;
   ChartGetInteger(0, CHART_WIDTH_IN_PIXELS, 0, chartWidthPixels);
   if(chartWidthPixels < panelWidth + rightMargin + 20)
   {
      DeleteObjectsWithPrefix(g_objectPrefix + "TRACK");
      DeleteObjectsWithPrefix(g_objectPrefix + "ANALYSIS_ROW_");
      g_lastTrackerHistoryCount = -1;
      return;
   }
   int x = (int)chartWidthPixels - rightMargin - panelWidth;
   if(ShowEAStatus && x < DashboardX + 420)
   {
      // Avoid overlaying the command HUD on narrow charts.
      DeleteObjectsWithPrefix(g_objectPrefix + "TRACK");
      DeleteObjectsWithPrefix(g_objectPrefix + "ANALYSIS_ROW_");
      g_lastTrackerHistoryCount = -1;
      return;
   }
   if(x < 5) x = 5;
   int textX = x + 10;
   int columnHeaderY = y + headerHeight + 2;
   int rowStartY = columnHeaderY + 27;
   int totalY = rowStartY + displayedRows * rowHeight + 4;
   int analysisHeaderY = totalY + 23;
   int analysisColumnsY = analysisHeaderY + 22;
   int analysisRowsY = analysisColumnsY + 21;
   // Match the 610-pixel height of the main dashboard at all times.
   int cardHeight = 610;

   DrawRaisedCardWithHeader(g_objectPrefix + "TRACKER_CARD", x, y,
                            panelWidth, cardHeight, headerHeight,
                            g_styleTrackerHeader,
                            "RBS / PERFORMANCE ("
                            + IntegerToString(days) + "D)");
   SetCardLabel(g_objectPrefix + "TRACK_SYMBOL",
                x + panelWidth - 68, y + 18,
                TrackerAllSymbolsWithMagic ? "ALL" : ShortText(Symbol(), 9),
                UseFuturisticDashboard ? g_styleText : g_styleHeaderText, trackerFont, true);
   SetScreenRectangle(g_objectPrefix + "TRACK_COL_BG", x + 1,
                      columnHeaderY, panelWidth - 2, 24,
                      g_styleTableHeader, g_styleTableHeader, 4);
   SetTrackerRow(g_objectPrefix + "TRACK_HEAD", textX,
                 columnHeaderY + 6,
                 "DATE       LOT    PROFIT   GAIN%   TRADES   W/L",
                 g_styleTableText, trackerFont, true);

   for(int staleRow = 0; staleRow < 60; staleRow++)
      DeleteObjectIfExists(g_objectPrefix + "TRACK_ROW_"
                           + IntegerToString(staleRow));

   double cumulativeRecentProfit = 0.0;
   int rowSlot = 0;
   for(int d = 0; d < days; d++)
   {
      cumulativeRecentProfit += dayProfit[d];
      if(d > 0 && dayTrades[d] <= 0)
         continue;
      if(rowSlot >= displayedRows)
         break;

      double estimatedStartBalance = AccountBalance() - cumulativeRecentProfit;
      if(estimatedStartBalance <= 0.0) estimatedStartBalance = AccountBalance();
      double gainPercent = estimatedStartBalance > 0.0
                           ? dayProfit[d] / estimatedStartBalance * 100.0 : 0.0;
      datetime rowDate = todayStart - d * 86400;
      string winLoss = IntegerToString(dayWins[d]) + "/"
                       + IntegerToString(dayLosses[d]);
      string row = PadRight(TimeToString(rowDate, TIME_DATE), 11)
                   + PadLeft(DoubleToString(dayLots[d], 2), 6)
                   + PadLeft(SignedNumber(dayProfit[d], 2), 10)
                   + PadLeft(SignedNumber(gainPercent, 2) + "%", 9)
                   + PadLeft(IntegerToString(dayTrades[d]), 8)
                   + PadLeft(winLoss, 8);
      color rowColor = dayProfit[d] > 0.0 ? SuccessColor
                       : (dayProfit[d] < 0.0 ? FailureColor
                                             : g_styleLabel);
      SetTrackerRow(g_objectPrefix + "TRACK_ROW_" + IntegerToString(rowSlot),
                    textX, rowStartY + rowSlot * rowHeight,
                    row, rowColor, trackerFont, false);
      rowSlot++;
   }

   string totalWinLoss = IntegerToString(monthlyWins) + "/"
                         + IntegerToString(monthlyLosses);
   string totalRow = PadRight("LAST 30D", 11)
                     + PadLeft(DoubleToString(monthlyLots, 2), 6)
                     + PadLeft(SignedNumber(monthlyProfit, 2), 10)
                     + PadLeft(SignedNumber(TrackerGainPercent(monthlyProfit), 2)
                               + "%", 9)
                     + PadLeft(IntegerToString(monthlyTrades), 8)
                     + PadLeft(totalWinLoss, 8);
   SetScreenRectangle(g_objectPrefix + "TRACK_TOTAL_BG", x + 1, totalY - 3,
                      panelWidth - 2, 20,
                      g_styleTotal, g_styleTotal, 4);
   SetTrackerRow(g_objectPrefix + "TRACK_TOTAL", textX, totalY,
                 totalRow, clrWhite, trackerFont, true);

   SetScreenRectangle(g_objectPrefix + "TRACK_ANALYSIS_BG", x + 1,
                      analysisHeaderY, panelWidth - 2, 19,
                      g_styleAnalysis, g_styleAnalysis, 4);
   SetCardLabel(g_objectPrefix + "TRACK_ANALYSIS_TITLE", x + 10,
                analysisHeaderY + 2, "[-] ANALYSIS - WIN RATE",
                clrWhite, 9, true);
   SetScreenRectangle(g_objectPrefix + "TRACK_ANALYSIS_COL_BG", x + 1,
                      analysisColumnsY, panelWidth - 2, 18,
                      g_styleAnalysisColumns, g_styleAnalysisColumns, 4);
   SetTrackerRow(g_objectPrefix + "TRACK_ANALYSIS_HEAD", textX,
                 analysisColumnsY + 4,
                 "PERIOD       TRADES   WIN%    PROFIT   GAIN%   LOTS",
                 g_styleTableText, trackerFont, true);

   SetAnalysisLine(0, textX, analysisRowsY,
                   "TODAY", dayTrades[0], dayWins[0], dayLosses[0],
                   dayProfit[0], dayLots[0], trackerFont);
   SetAnalysisLine(1, textX, analysisRowsY + analysisSpacing,
                   "LAST 7 DAYS", weeklyTrades, weeklyWins, weeklyLosses,
                   weeklyProfit, weeklyLots, trackerFont);
   SetAnalysisLine(2, textX, analysisRowsY + analysisSpacing * 2,
                   "THIS WEEK", thisWeekTrades, thisWeekWins, thisWeekLosses,
                   thisWeekProfit, thisWeekLots, trackerFont);
   SetAnalysisLine(3, textX, analysisRowsY + analysisSpacing * 3,
                   "LAST 30 DAYS", monthlyTrades, monthlyWins, monthlyLosses,
                   monthlyProfit, monthlyLots, trackerFont);
   SetAnalysisLine(4, textX, analysisRowsY + analysisSpacing * 4,
                   "THIS MONTH", thisMonthTrades, thisMonthWins, thisMonthLosses,
                   thisMonthProfit, thisMonthLots, trackerFont);
   SetAnalysisLine(5, textX, analysisRowsY + analysisSpacing * 5,
                   "ALL TIME", totalTrades, totalWins, totalLosses,
                   totalProfit, totalLots, trackerFont);
}

double TrackerGainPercent(const double profit)
{
   double estimatedStart = AccountBalance() - profit;
   if(estimatedStart <= 0.0) estimatedStart = AccountBalance();
   if(estimatedStart <= 0.0) return(0.0);
   return(profit / estimatedStart * 100.0);
}

