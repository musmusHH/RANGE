int OnInit()
{
   if(EnableQualityFilter && RequireClosedSignalBar &&
      EntryTiming != ENTRY_AFTER_BAR_CLOSE)
   {
      Print("RBS EA: closed-bar quality filter requires EntryTiming=ENTRY_AFTER_BAR_CLOSE.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(TrendFastEMA < 1 || TrendSlowEMA <= TrendFastEMA ||
      FilterADXPeriod < 1 || MinimumADX < 0.0 || MinimumADX > 100.0 ||
      MinimumBodyFraction < 0.0 || MinimumBodyFraction > 1.0 ||
      MaximumRejectionWickFraction < 0.0 || MaximumRejectionWickFraction > 1.0 ||
      BreakoutBufferATR < 0.0 || MaximumBreakoutExtensionATR <= BreakoutBufferATR ||
      MaximumSignalRangeATR <= 0.0 || MaximumSpreadATR < 0.0 ||
      EstimatedRoundTurnCommissionPerLot < 0.0 ||
      SessionStartHour < 0 || SessionStartHour > 23 ||
      SessionEndHour < 0 || SessionEndHour > 23 ||
      (EnableSessionFilter && SessionStartHour == SessionEndHour))
   {
      Print("RBS EA: invalid quality, session or commission setting.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(SignalRangeLength < 1 || SignalConfirmationLength < 0 ||
      SignalATRPeriod < 1)
   {
      Print("RBS EA: invalid signal length setting.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(SignalHistoryBars < 100)
   {
      Print("RBS EA: SignalHistoryBars must be at least 100.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(MaxOpenPositions < 1)
   {
      Print("RBS EA: MaxOpenPositions must be at least 1.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(LotSizingMode == LOT_FIXED && FixedLots <= 0.0)
   {
      Print("RBS EA: FixedLots must be greater than zero.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if((LotSizingMode == LOT_RISK_PERCENT ||
       (LotSizingMode == LOT_FIXED && EnforceFixedLotRiskAsActualStop)) &&
      RiskPercent <= 0.0)
   {
      Print("RBS EA: RiskPercent must be greater than zero.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(LotSizingMode == LOT_BALANCE_STEP_NOMINAL &&
      (StepStartingBalance <= 0.0 || StepStartingLot <= 0.0 ||
       BalanceProfitStep <= 0.0 || LotIncrementPerStep <= 0.0 ||
       NominalRiskPer001Lot <= 0.0))
   {
      Print("RBS EA: balance-step lot/risk settings must be positive.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(EnableDailyLossLimit && MaximumDailyLossPercent <= 0.0)
   {
      Print("RBS EA: MaximumDailyLossPercent must be positive.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(ShowProfitTracker && (ProfitTrackerDays < 1 || ProfitTrackerDays > 60))
   {
      Print("RBS EA: ProfitTrackerDays must be between 1 and 60.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(ShowProfitTracker &&
      (ProfitTrackerHeaderHeight < 30 || ProfitTrackerHeaderHeight > 80 ||
       ProfitTrackerFontSize < 7 || ProfitTrackerFontSize > 12))
   {
      Print("RBS EA: tracker header must be 30-80 px and font 7-12.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(ShowClosedTradeResultCards &&
      (ClosedTradeCardWidth < 110 || ClosedTradeCardWidth > 260 ||
       ClosedTradeCardHeight < 34 || ClosedTradeCardHeight > 80))
   {
      Print("RBS EA: trade-result card width must be 110-260 and height 34-80.");
      return(INIT_PARAMETERS_INCORRECT);
   }
   if(EnableTrailingStop &&
      (TrailingStartPoints < 1 || TrailingDistancePoints < 1 ||
       TrailingStepPoints < 1))
   {
      Print("RBS EA: trailing start, distance and step must be positive.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   long chartPart = ChartID() % 1000000;
   g_objectPrefix = "RBS2_" + IntegerToString((int)chartPart) + "_";
   DeleteEAObjects();

   g_activePanelStyle = (int)PanelStyle;
   g_panelStyleMemoryKey = "RBS_STYLE_"
                           + IntegerToString(AccountNumber()) + "_"
                           + IntegerToString(MagicNumber) + "_"
                           + Symbol() + "_" + IntegerToString(Period());
   if(RememberPanelStyleSelection &&
      GlobalVariableCheck(g_panelStyleMemoryKey))
   {
      int rememberedStyle = (int)GlobalVariableGet(g_panelStyleMemoryKey);
      if(rememberedStyle >= 0 && rememberedStyle <= 9)
         g_activePanelStyle = rememberedStyle;
   }
   ConfigurePanelStyle();
   if(ApplyProfessionalChartTheme)
      ApplyProChartTheme();

   g_engineInitialized = false;
   g_currentChartBar = 0;
   InitializeDailyRiskState();
   if(ForceSessionOnlyMode)
      Print("RBS EA: SESSION-ONLY MODE active | quality/trend/ADX/volume/spread entry gates disabled.");
   if(ForceFixedLotTradeMode)
      Print("RBS EA: FORCED TRADE MODE active | lots=",
            DoubleToString(ForcedTradeLots, LotDigits()),
            " | risk=", DoubleToString(ForcedTradeRiskPercent, 2),
            "% | legacy risk-budget skipping disabled.");
   g_status = "Waiting to initialize signal history";
   UpdateStatusDisplay();
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   DeleteEAObjects();
   if(ShowEAStatus)
      Comment("");
   ChartRedraw(0);
}

void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id == CHARTEVENT_OBJECT_CLICK)
   {
      if(sparam == g_objectPrefix + "FUT_PAUSE" ||
         sparam == g_objectPrefix + "FUT_TAB0" ||
         sparam == g_objectPrefix + "FUT_TAB1" ||
         sparam == g_objectPrefix + "FUT_TAB2")
      {
         if(sparam == g_objectPrefix + "FUT_PAUSE")
            g_entriesPaused = !g_entriesPaused;
         else if(sparam == g_objectPrefix + "FUT_TAB0") g_dashboardTab = 0;
         else if(sparam == g_objectPrefix + "FUT_TAB1") g_dashboardTab = 1;
         else g_dashboardTab = 2;
         DeleteObjectsWithPrefix(g_objectPrefix + "FUT_");
         g_lastDashboardUpdate = 0;
         UpdateStatusDisplay();
         ChartRedraw(0);
         return;
      }
      if(sparam == g_objectPrefix + "STYLE_PREV")
      {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         ChangePanelStyle(-1);
         return;
      }
      if(sparam == g_objectPrefix + "STYLE_NEXT")
      {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         ChangePanelStyle(1);
         return;
      }
   }

   if(id == CHARTEVENT_CHART_CHANGE)
   {
      g_lastTrackerHistoryCount = -1;
      g_lastResultCardHistoryCount = -1;
      g_lastDashboardUpdate = 0;
      g_lastDashboardStatus = "";
      UpdateStatusDisplay();
      ChartRedraw(0);
   }
}

//+------------------------------------------------------------------+
//| Main tick                                                        |
//+------------------------------------------------------------------+
void OnTick()
{
   UpdateDailyLossProtection();
   ManageTrailingStops();

   int minimumBars = SignalRangeLength + SignalConfirmationLength
                     + SignalATRPeriod + 20;
   if(Bars < minimumBars)
   {
      g_status = "Waiting for sufficient chart history";
      UpdateStatusDisplay();
      return;
   }

   if(!g_engineInitialized)
   {
      int startupDirection = 0;
      double startupTop = 0.0;
      double startupBottom = 0.0;
      bool startupVolumeAligned = false;
      datetime startupSignalTime = 0;

      if(!InitializeSignalEngine(startupDirection, startupTop, startupBottom,
                                 startupVolumeAligned, startupSignalTime))
      {
         g_status = "Signal engine initialization failed";
         UpdateStatusDisplay();
         return;
      }

      g_currentChartBar = iTime(NULL, 0, 0);
      g_engineInitialized = true;

      if(TradeSignalOnStartup && EntryTiming == ENTRY_AFTER_BAR_CLOSE &&
         startupDirection != 0)
      {
         HandleSignal(startupDirection, startupSignalTime, 1,
                      startupTop, startupBottom, startupVolumeAligned);
      }
      else if(!TradeSignalOnStartup &&
              (EntryTiming == ENTRY_IMMEDIATELY ||
               EntryTiming == ENTRY_BOTH))
      {
         // Do not enter an already-existing intrabar signal immediately
         // after attaching the EA. Start monitoring from the next candle.
         g_suppressIntrabarUntilNextBar = g_currentChartBar;
      }

      if(!TradeSignalOnStartup)
      {
         g_status = "Initialized; waiting for a new signal";
         UpdateStatusDisplay();
         return;
      }
   }

   datetime chartBar = iTime(NULL, 0, 0);
   bool newBar = (chartBar != g_currentChartBar);

   if(newBar)
   {
      g_currentChartBar = chartBar;
      g_suppressIntrabarUntilNextBar = 0;
      g_lastResultCardHistoryCount = -1;
      DeleteLiveObjects();

      // The newly completed bar is the result candle for any breakout
      // that was pending from the preceding completed candle.
      EvaluatePendingOutcome(1);

      int direction = 0;
      double breakoutTop = 0.0;
      double breakoutBottom = 0.0;
      bool volumeAligned = false;

      // Commit the candle that has just closed. This advances the internal
      // range state once per bar and avoids the old iCustom full-history scan.
      ProcessCommittedBar(1, direction, breakoutTop, breakoutBottom,
                          volumeAligned);

      if(direction != 0)
      {
         g_pendingSignalTime = iTime(NULL, 0, 1);
         g_pendingDirection = direction;
      }

      if((EntryTiming == ENTRY_AFTER_BAR_CLOSE ||
          EntryTiming == ENTRY_BOTH) && direction != 0)
      {
         HandleSignal(direction, iTime(NULL, 0, 1), 1,
                      breakoutTop, breakoutBottom, volumeAligned);
      }
   }

   if((EntryTiming == ENTRY_IMMEDIATELY ||
       EntryTiming == ENTRY_BOTH) &&
      g_suppressIntrabarUntilNextBar != chartBar)
   {
      EvaluateCurrentIntrabar();
   }
   else if(ShowChartObjects && g_rangeActive)
   {
      DrawRangeZone(g_activeRangeObjectBase, g_rangeCreatedTime,
                    iTime(NULL, 0, 0), g_rangeTop, g_rangeBottom);
   }

   UpdateStatusDisplay();
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| One-time historical state reconstruction                         |
//+------------------------------------------------------------------+
bool InitializeSignalEngine(int &lastDirection,
                            double &lastTop,
                            double &lastBottom,
                            bool &lastVolumeAligned,
                            datetime &lastSignalTime)
{
   g_rangeActive = false;
   g_rangeTop = 0.0;
   g_rangeBottom = 0.0;
   g_rangeCreatedTime = 0;
   g_activeRangeObjectBase = "";
   g_pendingSignalTime = 0;
   g_pendingDirection = 0;
   ArrayResize(g_outcomeSignalTime, 0);
   ArrayResize(g_outcomeDirection, 0);
   ArrayResize(g_outcomeSuccess, 0);

   int months = AnalysisMonths;
   if(months < 1) months = 1;
   g_analysisEnd = TimeCurrent();
   g_analysisStart = SubtractCalendarMonths(g_analysisEnd, months);

   lastDirection = 0;
   lastTop = 0.0;
   lastBottom = 0.0;
   lastVolumeAligned = false;
   lastSignalTime = 0;

   int tail = SignalConfirmationLength;
   if(tail < 1) tail = 1;
   int lookback = SignalRangeLength;
   if(SignalATRPeriod > lookback) lookback = SignalATRPeriod;

   int oldestAvailable = Bars - lookback - tail - 1;
   if(oldestAvailable < 2)
      return(false);

   int oldest = oldestAvailable;
   if(SignalHistoryBars > 0 && oldest > SignalHistoryBars - 1)
      oldest = SignalHistoryBars - 1;

   if(EnsureFullAnalysisWindow)
   {
      int analysisShift = iBarShift(NULL, 0, g_analysisStart, false);
      if(analysisShift < 0) analysisShift = Bars - 1;
      int warmup = AnalysisWarmupBars;
      if(warmup < 0) warmup = 0;
      int requiredOldest = analysisShift + warmup;
      if(requiredOldest > oldestAvailable) requiredOldest = oldestAvailable;
      if(oldest < requiredOldest) oldest = requiredOldest;
   }

   g_fullAnalysisCoverage = (iTime(NULL, 0, oldest) <= g_analysisStart);

   int needed = oldest + tail;
   double volatility[];
   ArrayResize(volatility, needed + 1);
   ArraySetAsSeries(volatility, true);

   for(int k = needed; k >= 0; k--)
      volatility[k] = CalculateVolatility(k);

   for(int i = oldest; i >= 1; i--)
   {
      bool zoneCondition = false;
      if(!g_rangeActive)
      {
         bool underNow = (volatility[i] < SignalVolatilityThreshold);
         zoneCondition = (underNow &&
                          volatility[i + 1] >= SignalVolatilityThreshold &&
                          volatility[i + SignalConfirmationLength]
                             < SignalVolatilityThreshold);
      }

      int direction = 0;
      double top = 0.0;
      double bottom = 0.0;
      bool aligned = false;
      ProcessRangeBar(i, zoneCondition, direction, top, bottom, aligned);

      if(direction != 0)
      {
         if(i >= 2)
            RecordHistoricalOutcome(i, direction);
         else
         {
            g_pendingSignalTime = iTime(NULL, 0, 1);
            g_pendingDirection = direction;
         }
      }

      if(i == 1 && direction != 0)
      {
         lastDirection = direction;
         lastTop = top;
         lastBottom = bottom;
         lastVolumeAligned = aligned;
         lastSignalTime = iTime(NULL, 0, 1);
      }
   }

   RecalculateOutcomeStatistics();
   Print("RBS EA: standalone signal engine initialized using ",
         oldest, " historical bars. Outcomes in analysis window: ",
         g_totalOutcomes, ".");
   return(true);
}

//+------------------------------------------------------------------+
//| Advance committed state using a completed chart candle           |
//+------------------------------------------------------------------+
void ProcessCommittedBar(const int shift,
                         int &direction,
                         double &breakoutTop,
                         double &breakoutBottom,
                         bool &volumeAligned)
{
   bool zoneCondition = false;
   if(!g_rangeActive)
      zoneCondition = IsZoneCondition(shift);

   ProcessRangeBar(shift, zoneCondition, direction,
                   breakoutTop, breakoutBottom, volumeAligned);
}

//+------------------------------------------------------------------+
//| Pine state transition for one bar                                |
//+------------------------------------------------------------------+
void ProcessRangeBar(const int shift,
                     const bool zoneCondition,
                     int &direction,
                     double &breakoutTop,
                     double &breakoutBottom,
                     bool &volumeAligned)
{
   direction = 0;
   breakoutTop = 0.0;
   breakoutBottom = 0.0;
   volumeAligned = false;

   if(zoneCondition && !g_rangeActive)
   {
      double vrange = iATR(NULL, 0, SignalATRPeriod, shift)
                      * SignalATRMultiplier;
      double center = iClose(NULL, 0, shift);
      g_rangeTop = center + vrange;
      g_rangeBottom = center - vrange;
      g_rangeCreatedTime = iTime(NULL, 0,
                                 shift + SignalConfirmationLength);
      g_activeRangeObjectBase = g_objectPrefix + "RANGE_"
                                + IntegerToString((int)g_rangeCreatedTime);
      g_rangeActive = true;
   }

   if(!g_rangeActive)
      return;

   double barClose = iClose(NULL, 0, shift);
   if(barClose > g_rangeTop || barClose < g_rangeBottom)
   {
      direction = barClose > g_rangeTop ? 1 : -1;
      breakoutTop = g_rangeTop;
      breakoutBottom = g_rangeBottom;
      volumeAligned = IsVolumeAligned(direction, shift);

      if(ShouldDrawShift(shift))
      {
         DrawRangeZone(g_activeRangeObjectBase, g_rangeCreatedTime,
                       iTime(NULL, 0, shift), breakoutTop, breakoutBottom);
         DrawBreakoutArrow(iTime(NULL, 0, shift), shift, direction,
                           breakoutTop, breakoutBottom, false);
      }

      g_rangeActive = false;
      g_rangeTop = 0.0;
      g_rangeBottom = 0.0;
      g_rangeCreatedTime = 0;
      g_activeRangeObjectBase = "";
   }
   else if(shift == 1 && ShouldDrawShift(shift))
   {
      DrawRangeZone(g_activeRangeObjectBase, g_rangeCreatedTime,
                    iTime(NULL, 0, shift), g_rangeTop, g_rangeBottom);
   }
}

//+------------------------------------------------------------------+
//| Realtime evaluation from last committed state (no mutation)      |
//+------------------------------------------------------------------+
void EvaluateCurrentIntrabar()
{
   DeleteLiveObjects();

   bool active = g_rangeActive;
   double top = g_rangeTop;
   double bottom = g_rangeBottom;
   datetime leftTime = g_rangeCreatedTime;
   string liveRangeBase = g_activeRangeObjectBase;

   if(!active && IsZoneCondition(0))
   {
      double vrange = iATR(NULL, 0, SignalATRPeriod, 0)
                      * SignalATRMultiplier;
      double center = iClose(NULL, 0, 0);
      top = center + vrange;
      bottom = center - vrange;
      leftTime = iTime(NULL, 0, SignalConfirmationLength);
      liveRangeBase = g_objectPrefix + "LIVE_RANGE";
      active = true;
   }

   if(!active)
   {
      g_status = "Monitoring current candle for a range/breakout";
      return;
   }

   if(ShowChartObjects)
      DrawRangeZone(liveRangeBase, leftTime, iTime(NULL, 0, 0), top, bottom);

   double currentClose = iClose(NULL, 0, 0);
   if(currentClose > top || currentClose < bottom)
   {
      int direction = currentClose > top ? 1 : -1;
      bool volumeAligned = IsVolumeAligned(direction, 0);
      DrawBreakoutArrow(iTime(NULL, 0, 0), 0, direction,
                        top, bottom, true);
      HandleSignal(direction, iTime(NULL, 0, 0), 0,
                   top, bottom, volumeAligned);
   }
   else
   {
      g_status = "Active range; monitoring current candle";
   }
}

bool IsZoneCondition(const int shift)
{
   double currentVolatility = CalculateVolatility(shift);
   if(currentVolatility >= SignalVolatilityThreshold)
      return(false);

   double precedingVolatility = CalculateVolatility(shift + 1);
   if(precedingVolatility < SignalVolatilityThreshold)
      return(false);

   double confirmedVolatility = CalculateVolatility(
                                 shift + SignalConfirmationLength);
   return(confirmedVolatility < SignalVolatilityThreshold);
}

//+------------------------------------------------------------------+
//| Rolling mean/median body-distance ratio                          |
//+------------------------------------------------------------------+
double CalculateVolatility(const int shift)
{
   double samples[];
   ArrayResize(samples, SignalRangeLength);

   double sum = 0.0;
   for(int j = 0; j < SignalRangeLength; j++)
   {
      double value = MathAbs(iClose(NULL, 0, shift + j)
                             - iOpen(NULL, 0, shift + j));
      samples[j] = value;
      sum += value;
   }

   ArraySort(samples, WHOLE_ARRAY, 0, MODE_ASCEND);
   double median;
   if((SignalRangeLength % 2) == 1)
      median = samples[SignalRangeLength / 2];
   else
      median = (samples[SignalRangeLength / 2 - 1]
                + samples[SignalRangeLength / 2]) * 0.5;

   if(median <= 0.0)
      return(1.0e100);
   return((sum / SignalRangeLength) / median);
}

//+------------------------------------------------------------------+
//| Volume confirmation                                              |
//+------------------------------------------------------------------+
bool IsVolumeAligned(const int direction, const int shift)
{
   if(SignalMode == TRADE_ALL_BREAKOUTS)
      return(true);

   double ratio = VolumeRatio(shift);
   if(direction > 0)
      return(ratio > 1.0);
   return(ratio <= 1.0);
}

double VolumeRatio(const int shift)
{
   double upSum = 0.0;
   double downSum = 0.0;

   for(int j = 0; j <= SignalConfirmationLength; j++)
   {
      double up = 0.0;
      double down = 0.0;
      CalculateUpDownVolume(shift + j, up, down);
      upSum += up;
      downSum += down;
   }

   if(downSum <= 0.0)
   {
      if(upSum <= 0.0) return(1.0);
      return(1000000.0);
   }
   return(MathAbs(upSum / downSum));
}

void CalculateUpDownVolume(const int chartShift,
                           double &up,
                           double &down)
{
   up = 0.0;
   down = 0.0;

   int lowerTF = (int)SignalLowerTimeframe;
   int chartTF = Period();
   if(lowerTF <= 0 || lowerTF >= chartTF)
   {
      ClassifyChartVolume(chartShift, up, down);
      return;
   }

   datetime startTime = iTime(NULL, 0, chartShift);
   datetime endTime = chartShift > 0
                      ? iTime(NULL, 0, chartShift - 1)
                      : TimeCurrent() + 1;

   int oldestShift = iBarShift(NULL, lowerTF, startTime, false);
   int newestShift = iBarShift(NULL, lowerTF, endTime - 1, false);
   if(oldestShift < 0 || newestShift < 0 || oldestShift < newestShift)
   {
      ClassifyChartVolume(chartShift, up, down);
      return;
   }

   bool found = false;
   for(int s = oldestShift; s >= newestShift; s--)
   {
      datetime lowerTime = iTime(NULL, lowerTF, s);
      if(lowerTime < startTime || lowerTime >= endTime)
         continue;

      double v = (double)iVolume(NULL, lowerTF, s);
      if(IsLowerBarUp(lowerTF, s))
         up += v;
      else
         down += v;
      found = true;
   }

   if(!found)
      ClassifyChartVolume(chartShift, up, down);
}

bool IsLowerBarUp(const int timeframe, const int shift)
{
   double c = iClose(NULL, timeframe, shift);
   double o = iOpen(NULL, timeframe, shift);
   if(c > o) return(true);
   if(c < o) return(false);

   double priorClose = iClose(NULL, timeframe, shift + 1);
   if(c > priorClose) return(true);
   if(c < priorClose) return(false);

   int bars = iBars(NULL, timeframe);
   int limit = shift + 100;
   if(limit > bars - 2) limit = bars - 2;
   for(int s = shift + 1; s <= limit; s++)
   {
      double olderClose = iClose(NULL, timeframe, s);
      double olderOpen = iOpen(NULL, timeframe, s);
      if(olderClose > olderOpen) return(true);
      if(olderClose < olderOpen) return(false);

      double stillOlderClose = iClose(NULL, timeframe, s + 1);
      if(olderClose > stillOlderClose) return(true);
      if(olderClose < stillOlderClose) return(false);
   }
   return(true);
}

void ClassifyChartVolume(const int shift, double &up, double &down)
{
   double c = iClose(NULL, 0, shift);
   double o = iOpen(NULL, 0, shift);
   bool isUp = true;

   if(c > o)
      isUp = true;
   else if(c < o)
      isUp = false;
   else
   {
      double priorClose = iClose(NULL, 0, shift + 1);
      if(c > priorClose) isUp = true;
      else if(c < priorClose) isUp = false;
   }

   double v = (double)iVolume(NULL, 0, shift);
   if(isUp) up = v;
   else down = v;
}

//+------------------------------------------------------------------+
//| Next-candle outcome analysis                                     |
//+------------------------------------------------------------------+
void RecordHistoricalOutcome(const int eventShift, const int direction)
{
   if(eventShift < 2)
      return;

   int resultShift = eventShift - 1;
   bool success = direction > 0
                  ? iClose(NULL, 0, resultShift) > iOpen(NULL, 0, resultShift)
                  : iClose(NULL, 0, resultShift) < iOpen(NULL, 0, resultShift);
   datetime signalTime = iTime(NULL, 0, eventShift);
   AppendOutcome(signalTime, direction, success);

   if(ShowOutcomeMarkers && signalTime >= g_analysisStart &&
      ShouldDrawShift(resultShift))
      DrawOutcomeMarker(signalTime, resultShift, direction, success);
}

void EvaluatePendingOutcome(const int resultShift)
{
   if(g_pendingDirection == 0 || g_pendingSignalTime <= 0)
      return;

   bool success = g_pendingDirection > 0
                  ? iClose(NULL, 0, resultShift) > iOpen(NULL, 0, resultShift)
                  : iClose(NULL, 0, resultShift) < iOpen(NULL, 0, resultShift);
   AppendOutcome(g_pendingSignalTime, g_pendingDirection, success);

   g_analysisEnd = TimeCurrent();
   int months = AnalysisMonths;
   if(months < 1) months = 1;
   g_analysisStart = SubtractCalendarMonths(g_analysisEnd, months);

   if(ShowOutcomeMarkers && g_pendingSignalTime >= g_analysisStart)
      DrawOutcomeMarker(g_pendingSignalTime, resultShift,
                        g_pendingDirection, success);

   g_pendingSignalTime = 0;
   g_pendingDirection = 0;
   RecalculateOutcomeStatistics();
}

void AppendOutcome(const datetime signalTime,
                   const int direction,
                   const bool success)
{
   int size = ArraySize(g_outcomeSignalTime);
   ArrayResize(g_outcomeSignalTime, size + 1);
   ArrayResize(g_outcomeDirection, size + 1);
   ArrayResize(g_outcomeSuccess, size + 1);
   g_outcomeSignalTime[size] = signalTime;
   g_outcomeDirection[size] = direction;
   g_outcomeSuccess[size] = success ? 1 : 0;
}

void RecalculateOutcomeStatistics()
{
   g_totalOutcomes = 0;
   g_successfulOutcomes = 0;
   g_failedOutcomes = 0;
   g_bullishOutcomes = 0;
   g_bullishSuccesses = 0;
   g_bearishOutcomes = 0;
   g_bearishSuccesses = 0;

   int size = ArraySize(g_outcomeSignalTime);
   for(int i = 0; i < size; i++)
   {
      if(g_outcomeSignalTime[i] < g_analysisStart ||
         g_outcomeSignalTime[i] > g_analysisEnd)
         continue;

      bool success = (g_outcomeSuccess[i] == 1);
      int direction = g_outcomeDirection[i];
      g_totalOutcomes++;
      if(success) g_successfulOutcomes++;
      else g_failedOutcomes++;

      if(direction > 0)
      {
         g_bullishOutcomes++;
         if(success) g_bullishSuccesses++;
      }
      else
      {
         g_bearishOutcomes++;
         if(success) g_bearishSuccesses++;
      }
   }
}

double OutcomeRate(const int successful, const int total)
{
   if(total <= 0) return(0.0);
   return(100.0 * successful / total);
}

//+------------------------------------------------------------------+
//| Quality gates: no current HTF bar and no future data              |
//| Chart arrows/outcomes remain RAW signals, not filtered trades.    |
//+------------------------------------------------------------------+
bool RejectQuality(const string reason)
{
   g_qualityStatus = reason;
   g_qualityPassed = false;
   return(false);
}

bool PassesBreakoutQuality(const int direction, const int shift,
                          const double top, const double bottom)
{
   if(ForceSessionOnlyMode)
   {
      g_qualityStatus = "Session-only mode: quality gates disabled";
      g_qualityPassed = true;
      return(true);
   }
   if(!EnableQualityFilter)
   {
      g_qualityStatus = "Quality gates disabled";
      g_qualityPassed = true;
      return(true);
   }
   if(RequireClosedSignalBar && shift < 1)
      return(RejectQuality("Waiting for candle close"));
   if(shift < 0 || iBars(NULL, 0) < shift + SignalATRPeriod + 3 ||
      top <= bottom || bottom <= 0.0)
      return(RejectQuality("Missing candle/range history"));

   // ATR before the signal: a spike cannot inflate its own baseline.
   double atr = iATR(NULL, 0, SignalATRPeriod, shift + 1);
   double o = iOpen(NULL, 0, shift), c = iClose(NULL, 0, shift);
   double h = iHigh(NULL, 0, shift), l = iLow(NULL, 0, shift);
   double span = h - l;
   if(atr <= 0.0 || span <= 0.0 || o <= 0.0 || c <= 0.0)
      return(RejectQuality("Invalid ATR/candle data"));
   if(direction * (c - o) <= 0.0)
      return(RejectQuality("Candle direction disagrees"));
   if(MathAbs(c - o) / span < MinimumBodyFraction)
      return(RejectQuality("Weak candle body"));
   double wick = direction > 0 ? h - MathMax(o, c) : MathMin(o, c) - l;
   if(wick / span > MaximumRejectionWickFraction)
      return(RejectQuality("Large rejection wick"));
   double extension = direction > 0 ? c - top : bottom - c;
   if(extension < atr * BreakoutBufferATR)
      return(RejectQuality("Breakout too close to boundary"));
   if(extension > atr * MaximumBreakoutExtensionATR)
      return(RejectQuality("Breakout overextended"));
   if(span > atr * MaximumSignalRangeATR)
      return(RejectQuality("Spike candle exceeds ATR cap"));

   if(EnableADXFilter)
   {
      if(iBars(NULL, 0) < shift + 3 * FilterADXPeriod + 3)
         return(RejectQuality("Waiting for ADX history"));
      double adx = iADX(NULL, 0, FilterADXPeriod, PRICE_CLOSE, MODE_MAIN, shift);
      double plus = iADX(NULL, 0, FilterADXPeriod, PRICE_CLOSE, MODE_PLUSDI, shift);
      double minus = iADX(NULL, 0, FilterADXPeriod, PRICE_CLOSE, MODE_MINUSDI, shift);
      if(adx <= 0.0 || adx < MinimumADX)
         return(RejectQuality("ADX trend strength too low"));
      if((direction > 0 && plus <= minus) || (direction < 0 && minus <= plus))
         return(RejectQuality("ADX direction disagrees"));
   }
   if(EnableTrendFilter)
   {
      int tf = (int)TrendTimeframe;
      if(tf == PERIOD_CURRENT) tf = Period();
      datetime decision = shift > 0 ? iTime(NULL, 0, shift - 1) : TimeCurrent();
      int containing = iBarShift(NULL, tf, decision, false);
      int closed = containing + 1;
      if(containing < 0 || iBars(NULL, tf) < closed + TrendSlowEMA + 2 ||
         iTime(NULL, tf, containing) <= 0 ||
         decision >= iTime(NULL, tf, containing) + PeriodSeconds((ENUM_TIMEFRAMES)tf))
         return(RejectQuality("Waiting for synchronized trend history"));
      double fast = iMA(NULL, tf, TrendFastEMA, 0, MODE_EMA, PRICE_CLOSE, closed);
      double slow = iMA(NULL, tf, TrendSlowEMA, 0, MODE_EMA, PRICE_CLOSE, closed);
      double close = iClose(NULL, tf, closed);
      if(fast <= 0.0 || slow <= 0.0 || close <= 0.0)
         return(RejectQuality("Invalid trend data"));
      if((direction > 0 && (fast <= slow || close <= fast)) ||
         (direction < 0 && (fast >= slow || close >= fast)))
         return(RejectQuality("Closed HTF trend disagrees"));
   }
   g_qualityPassed = true;
   g_qualityStatus = "PASS: enabled signal gates";
   return(true);
}

bool InEntrySession()
{
   if(!EnableSessionFilter) return(true);
   int hour = TimeHour(TimeCurrent());
   if(SessionStartHour < SessionEndHour)
      return(hour >= SessionStartHour && hour < SessionEndHour);
   return(hour >= SessionStartHour || hour < SessionEndHour);
}

//+------------------------------------------------------------------+
//| Process an eligible breakout                                    |
//+------------------------------------------------------------------+
void HandleSignal(const int direction,
                  const datetime signalTime,
                  const int signalShift,
                  const double rangeTop,
                  const double rangeBottom,
                  const bool volumeAligned)
{
   if(direction == 0 || signalTime <= 0)
      return;

   if(direction > 0 && signalTime == g_lastHandledBullSignal)
      return;
   if(direction < 0 && signalTime == g_lastHandledBearSignal)
      return;

   if(!ForceSessionOnlyMode &&
      SignalMode == TRADE_VOLUME_CONFIRMED && !volumeAligned)
   {
      RejectQuality("Volume confirmation disagrees");
      g_status = "Breakout rejected: volume confirmation not aligned";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }

   if(!PassesBreakoutQuality(direction, signalShift, rangeTop, rangeBottom))
   {
      g_status = "Signal rejected: " + g_qualityStatus;
      LogEntryDiagnostic(direction, signalTime, g_status);
      if(signalShift > 0) MarkSignalHandled(direction, signalTime);
      return;
   }

   if(g_dailyLossBlocked)
   {
      MarkSignalHandled(direction, signalTime);
      g_status = "Signal blocked: daily loss limit "
                 + DoubleToString(MaximumDailyLossPercent, 1) + "% reached";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }

   bool hadOpposite = (CountOpenPositions(-direction) > 0);
   bool mustCloseOpposite = (CloseOnOppositeSignal ||
                             ExitMethod == EXIT_OPPOSITE_SIGNAL);
   if(hadOpposite && mustCloseOpposite)
   {
      if(!ClosePositions(-direction))
      {
         g_status = "Could not close opposite position(s)";
         LogEntryDiagnostic(direction, signalTime, g_status);
         return;
      }
      if(!OpenReverseTrade)
      {
         MarkSignalHandled(direction, signalTime);
         g_status = "Opposite position closed; reversal disabled";
         return;
      }
   }

   // Entry-only gates do not suppress qualified opposite-signal exits.
   if(g_entriesPaused || !InEntrySession())
   {
      MarkSignalHandled(direction, signalTime);
      g_status = g_entriesPaused ? "New entries paused; exits active"
                                : "Entry skipped: outside broker-time session";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }
   if(EnableQualityFilter && !ForceSessionOnlyMode)
   {
      RefreshRates();
      double atr = iATR(NULL, 0, SignalATRPeriod, signalShift + 1);
      double price = direction > 0 ? Ask : Bid;
      double distance = direction > 0 ? price - rangeTop : rangeBottom - price;
      if(atr <= 0.0 || distance < atr * BreakoutBufferATR ||
         distance > atr * MaximumBreakoutExtensionATR ||
         (direction > 0 && Bid <= rangeTop) ||
         (direction < 0 && Ask >= rangeBottom))
      {
         g_status = "Entry skipped: price retraced or overextended";
         LogEntryDiagnostic(direction, signalTime, g_status);
         return;
      }
      if(MaximumSpreadATR > 0.0 && Ask - Bid > atr * MaximumSpreadATR)
      {
         g_status = "Entry skipped: spread / ATR too high";
         LogEntryDiagnostic(direction, signalTime, g_status);
         return;
      }
   }

   if(direction > 0 && !AllowBuyTrades)
   {
      MarkSignalHandled(direction, signalTime);
      g_status = "Bullish signal handled; buys disabled";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }
   if(direction < 0 && !AllowSellTrades)
   {
      MarkSignalHandled(direction, signalTime);
      g_status = "Bearish signal handled; sells disabled";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }

   if(CountOpenPositions(0) >= MaxOpenPositions)
   {
      MarkSignalHandled(direction, signalTime);
      g_status = "Signal skipped: maximum positions reached";
      LogEntryDiagnostic(direction, signalTime, g_status);
      return;
   }

   if(MaximumSpreadPoints > 0 && !ForceSessionOnlyMode)
   {
      RefreshRates();
      double spread = (Ask - Bid) / Point;
      if(spread > MaximumSpreadPoints)
      {
         g_status = "Signal waiting: spread " + DoubleToString(spread, 1)
                    + " > maximum " + IntegerToString(MaximumSpreadPoints);
         return;
      }
   }

   if(OpenMarketPosition(direction, signalShift, rangeTop, rangeBottom))
      MarkSignalHandled(direction, signalTime);
   else
      LogEntryDiagnostic(direction, signalTime, g_status);
}

void LogEntryDiagnostic(const int direction,
                        const datetime signalTime,
                        const string reason)
{
   // Log once per signal/reason so the Journal remains readable while still
   // explaining every distinct reason an entry was not opened.
   if(signalTime == g_lastEntryDiagnosticSignal &&
      reason == g_lastEntryDiagnosticReason)
      return;

   g_lastEntryDiagnosticSignal = signalTime;
   g_lastEntryDiagnosticReason = reason;
   Print("RBS EA: ENTRY NOT OPENED | ",
         direction > 0 ? "BUY" : "SELL",
         " | signal ", TimeToString(signalTime, TIME_DATE|TIME_SECONDS),
         " | reason: ", reason,
         " | symbol=", Symbol(),
         " | equity=", DoubleToString(AccountEquity(), 2),
         " | lots=", DoubleToString(FixedLots, LotDigits()),
         " | risk=", DoubleToString(RiskPercent, 2), "%");
}

void MarkSignalHandled(const int direction, const datetime signalTime)
{
   if(direction > 0)
      g_lastHandledBullSignal = signalTime;
   else
      g_lastHandledBearSignal = signalTime;
}

//+------------------------------------------------------------------+
//| Calculate stops, size, and submit a market order                 |
//+------------------------------------------------------------------+
bool OpenMarketPosition(const int direction,
                        const int signalShift,
                        const double rangeTop,
                        const double rangeBottom)
{
   if(!IsTradeAllowed())
   {
      g_status = "Trading not allowed; check AutoTrading";
      return(false);
   }
   if(IsTradeContextBusy())
   {
      g_status = "Trade context busy; will retry";
      return(false);
   }

   RefreshRates();
   int command = direction > 0 ? OP_BUY : OP_SELL;
   double entry = direction > 0 ? Ask : Bid;
   double stopLoss = 0.0;
   double takeProfit = 0.0;

   if(!CalculateStops(direction, signalShift, entry, rangeTop, rangeBottom,
                      stopLoss, takeProfit))
      return(false);

   AdjustAndNormalizeStops(direction, entry, stopLoss, takeProfit);

   double riskDistance = stopLoss > 0.0
                         ? MathAbs(entry - stopLoss)
                         : RiskReferencePointsWithoutSL * Point;
   double lots = CalculateLots(riskDistance, command);
   if(lots <= 0.0)
   {
      g_status = "Lot calculation failed or free margin too low";
      return(false);
   }

   // Convert the requested risk percentage into a real monetary SL
   // distance using this symbol's tick size/value.
   if(ForceFixedLotTradeMode ||
      (LotSizingMode == LOT_BALANCE_STEP_NOMINAL &&
       EnforceTierRiskAsActualStop) ||
      (LotSizingMode == LOT_FIXED && EnforceFixedLotRiskAsActualStop))
   {
      if(!ApplyExactTierRiskStop(direction, entry, lots,
                                 stopLoss, takeProfit))
         return(false);
      AdjustAndNormalizeStops(direction, entry, stopLoss, takeProfit);
   }

   color orderColor = direction > 0 ? C'0,255,187' : C'255,17,0';
   ResetLastError();
   int ticket = OrderSend(Symbol(), command, lots,
                          NormalizeDouble(entry, Digits), SlippagePoints,
                          stopLoss, takeProfit, TradeComment,
                          MagicNumber, 0, orderColor);
   int sendError = GetLastError();

   // ECN fallback: submit without stops, then add them immediately.
   if(ticket < 0 && sendError == 130 &&
      (stopLoss > 0.0 || takeProfit > 0.0))
   {
      RefreshRates();
      entry = direction > 0 ? Ask : Bid;
      ResetLastError();
      ticket = OrderSend(Symbol(), command, lots,
                         NormalizeDouble(entry, Digits), SlippagePoints,
                         0, 0, TradeComment, MagicNumber, 0, orderColor);
      sendError = GetLastError();

      if(ticket >= 0)
      {
         // Recalculate the exact tier-risk stop from the broker's actual
         // ECN fill price before attaching protection.
         if((ForceFixedLotTradeMode ||
             (LotSizingMode == LOT_BALANCE_STEP_NOMINAL &&
              EnforceTierRiskAsActualStop) ||
             (LotSizingMode == LOT_FIXED && EnforceFixedLotRiskAsActualStop)) &&
            OrderSelect(ticket, SELECT_BY_TICKET))
         {
            if(!ApplyExactTierRiskStop(direction, OrderOpenPrice(), lots,
                                       stopLoss, takeProfit))
            {
               CloseTicket(ticket);
               return(false);
            }
         }

         bool modified = ApplyStopsAfterECNOrder(ticket, direction,
                                                 stopLoss, takeProfit);
         if(!modified && CloseTradeIfECNStopModifyFails && stopLoss > 0.0)
         {
            Print("RBS EA: protective stop modification failed; closing ticket ",
                  ticket, " for safety.");
            CloseTicket(ticket);
            g_status = "ECN stop modification failed; trade closed";
            return(false);
         }
      }
   }

   if(ticket < 0)
   {
      g_status = "OrderSend failed, error " + IntegerToString(sendError);
      Print("RBS EA: OrderSend failed. Error ", sendError,
            ", direction ", direction,
            ", lots ", DoubleToString(lots, LotDigits()),
            ", SL ", DoubleToString(stopLoss, Digits),
            ", TP ", DoubleToString(takeProfit, Digits));
      return(false);
   }

   g_status = (direction > 0 ? "BUY" : "SELL")
              + " opened, ticket " + IntegerToString(ticket)
              + ", lots " + DoubleToString(lots, LotDigits());
   Print("RBS EA: ", g_status);
   return(true);
}

//+------------------------------------------------------------------+
//| Exit calculations                                                |
//+------------------------------------------------------------------+
bool CalculateStops(const int direction,
                    const int signalShift,
                    const double entry,
                    const double rangeTop,
                    const double rangeBottom,
                    double &stopLoss,
                    double &takeProfit)
{
   stopLoss = 0.0;
   takeProfit = 0.0;

   if(ExitMethod == EXIT_OPPOSITE_SIGNAL)
      return(true);

   if(ExitMethod == EXIT_RANGE_RISK_REWARD)
   {
      if(rangeTop <= rangeBottom || rangeBottom <= 0.0)
      {
         g_status = "Internal range boundary unavailable; trade skipped";
         return(false);
      }
      stopLoss = direction > 0
                 ? rangeBottom - RangeStopBufferPoints * Point
                 : rangeTop + RangeStopBufferPoints * Point;
   }
   else if(ExitMethod == EXIT_ATR_RISK_REWARD)
   {
      double atr = iATR(NULL, 0, SignalATRPeriod, signalShift);
      if(atr <= 0.0)
      {
         g_status = "ATR unavailable; trade skipped";
         return(false);
      }
      double distance = atr * ATRStopMultiplier;
      stopLoss = direction > 0 ? entry - distance : entry + distance;
   }
   else if(ExitMethod == EXIT_FIXED_POINTS)
   {
      if(FixedStopLossPoints > 0)
         stopLoss = direction > 0
                    ? entry - FixedStopLossPoints * Point
                    : entry + FixedStopLossPoints * Point;
      if(FixedTakeProfitPoints > 0)
         takeProfit = direction > 0
                      ? entry + FixedTakeProfitPoints * Point
                      : entry - FixedTakeProfitPoints * Point;
      return(true);
   }

   if(stopLoss <= 0.0 ||
      (direction > 0 && stopLoss >= entry) ||
      (direction < 0 && stopLoss <= entry))
   {
      g_status = "Calculated stop is on the wrong side of entry";
      return(false);
   }

   double riskDistance = MathAbs(entry - stopLoss);
   if(RiskRewardRatio > 0.0)
      takeProfit = direction > 0
                   ? entry + riskDistance * RiskRewardRatio
                   : entry - riskDistance * RiskRewardRatio;
   return(true);
}

void AdjustAndNormalizeStops(const int direction,
                             const double entry,
                             double &stopLoss,
                             double &takeProfit)
{
   double minimumDistance = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   if(AdjustStopsToBrokerMinimum)
      minimumDistance += 2.0 * Point;

   if(stopLoss > 0.0 && AdjustStopsToBrokerMinimum)
   {
      if(direction > 0 && entry - stopLoss < minimumDistance)
         stopLoss = entry - minimumDistance;
      if(direction < 0 && stopLoss - entry < minimumDistance)
         stopLoss = entry + minimumDistance;
   }

   if(takeProfit > 0.0 && AdjustStopsToBrokerMinimum)
   {
      if(direction > 0 && takeProfit - entry < minimumDistance)
         takeProfit = entry + minimumDistance;
      if(direction < 0 && entry - takeProfit < minimumDistance)
         takeProfit = entry - minimumDistance;
   }

   if(stopLoss > 0.0) stopLoss = NormalizeDouble(stopLoss, Digits);
   if(takeProfit > 0.0) takeProfit = NormalizeDouble(takeProfit, Digits);
}

//+------------------------------------------------------------------+
//| Lot sizing                                                       |
//+------------------------------------------------------------------+
double CalculateLots(const double riskDistance, const int command)
{
   double lots;

   // Forced fixed mode prevents legacy Strategy Tester .set files from
   // returning to LOT_RISK_PERCENT and rejecting every 0.01-lot trade.
   if(ForceFixedLotTradeMode)
   {
      lots = ForcedTradeLots;
   }
   else if(LotSizingMode == LOT_FIXED)
   {
      lots = FixedLots;
   }
   else if(LotSizingMode == LOT_RISK_PERCENT)
   {
      if(riskDistance <= 0.0)
         return(0.0);

      double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE);
      double tickSize = MarketInfo(Symbol(), MODE_TICKSIZE);
      if(tickValue <= 0.0 || tickSize <= 0.0)
      {
         Print("RBS EA: broker returned invalid tick value/tick size.");
         return(0.0);
      }

      double riskMoney = AccountEquity() * RiskPercent / 100.0;
      double lossPerLot = (riskDistance / tickSize) * tickValue
                          + EstimatedRoundTurnCommissionPerLot;
      if(lossPerLot <= 0.0)
         return(0.0);
      lots = riskMoney / lossPerLot;
      // Never round UP to minimum lot and silently exceed the risk budget.
      double minimumLot = MarketInfo(Symbol(), MODE_MINLOT);
      if(minimumLot <= 0.0 || lots < minimumLot)
      {
         Print("RBS EA: risk budget cannot support broker minimum lot; skipped.");
         return(0.0);
      }
   }
   else
   {
      // Requested nominal progression:
      // $100 -> 0.01 lot, $250 -> 0.02 lot, then +0.01 per $150.
      lots = BalanceStepLotSize();
   }

   lots = NormalizeLots(lots);
   double freeAfter = AccountFreeMarginCheck(Symbol(), command, lots);
   if(freeAfter <= 0.0)
   {
      Print("RBS EA: insufficient free margin for ",
            DoubleToString(lots, LotDigits()), " lots.");
      return(0.0);
   }
   return(lots);
}

double BalanceStepLotSize()
{
   double balanceGrowth = AccountBalance() - StepStartingBalance;
   int completedSteps = 0;
   if(balanceGrowth >= BalanceProfitStep)
      completedSteps = (int)MathFloor(balanceGrowth / BalanceProfitStep);
   return(StepStartingLot + completedSteps * LotIncrementPerStep);
}

double NominalRiskForLot(const double lots)
{
   if(lots <= 0.0) return(0.0);
   return((lots / 0.01) * NominalRiskPer001Lot);
}

bool ApplyExactTierRiskStop(const int direction,
                            const double entry,
                            const double lots,
                            double &stopLoss,
                            double &takeProfit)
{
   double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE);
   double tickSize = MarketInfo(Symbol(), MODE_TICKSIZE);
   if(tickValue <= 0.0 || tickSize <= 0.0 || lots <= 0.0)
   {
      g_status = "Cannot calculate exact tier risk: invalid tick data";
      Print("RBS EA: exact tier-risk SL failed. Tick value ", tickValue,
            ", tick size ", tickSize, ", lots ", lots, ".");
      return(false);
   }

   double tierRiskPercent = ForceFixedLotTradeMode
                             ? ForcedTradeRiskPercent
                             : ((LotSizingMode == LOT_FIXED)
                                ? RiskPercent
                                : NominalRiskForLot(lots));
   double riskMoney = AccountEquity() * tierRiskPercent / 100.0;
   double moneyPerPriceUnit = (tickValue / tickSize) * lots;
   if(riskMoney <= 0.0 || moneyPerPriceUnit <= 0.0)
      return(false);

   double exactDistance = riskMoney / moneyPerPriceUnit;
   double brokerPoints = MarketInfo(Symbol(), MODE_STOPLEVEL);
   double freezePoints = MarketInfo(Symbol(), MODE_FREEZELEVEL);
   if(freezePoints > brokerPoints) brokerPoints = freezePoints;
   double minimumDistance = (brokerPoints + 2.0) * Point;

   if(exactDistance < minimumDistance)
   {
      if(SkipIfExactRiskStopIsTooClose)
      {
         g_status = "Exact risk SL is inside broker minimum; trade skipped";
         Print("RBS EA: exact ", DoubleToString(tierRiskPercent, 1),
               "% risk stop needs ", DoubleToString(exactDistance / Point, 1),
               " points, below broker minimum ",
               DoubleToString(minimumDistance / Point, 1), ".");
         return(false);
      }
      exactDistance = minimumDistance;
   }

   stopLoss = direction > 0 ? entry - exactDistance
                            : entry + exactDistance;
   if(stopLoss <= 0.0)
   {
      g_status = "Exact tier-risk stop produced an invalid price";
      return(false);
   }

   // Preserve a fixed-points TP when selected. Range/ATR R:R modes are
   // recalculated from the exact monetary-risk stop. Opposite-signal mode
   // receives the protective exact-risk SL but no automatic TP.
   if(ExitMethod == EXIT_RANGE_RISK_REWARD ||
      ExitMethod == EXIT_ATR_RISK_REWARD)
   {
      if(RiskRewardRatio > 0.0)
         takeProfit = direction > 0
                      ? entry + exactDistance * RiskRewardRatio
                      : entry - exactDistance * RiskRewardRatio;
      else
         takeProfit = 0.0;
   }
   else if(ExitMethod == EXIT_OPPOSITE_SIGNAL)
   {
      takeProfit = 0.0;
   }

   stopLoss = NormalizeDouble(stopLoss, Digits);
   if(takeProfit > 0.0)
      takeProfit = NormalizeDouble(takeProfit, Digits);

   g_status = "Exact tier risk " + DoubleToString(tierRiskPercent, 1)
              + "% = " + DoubleToString(riskMoney, 2)
              + " money risk";
   return(true);
}

double NormalizeLots(double lots)
{
   double minimum = MarketInfo(Symbol(), MODE_MINLOT);
   double maximum = MarketInfo(Symbol(), MODE_MAXLOT);
   double step = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(step <= 0.0) step = 0.01;

   if(lots < minimum) lots = minimum;
   if(lots > maximum) lots = maximum;
   lots = MathFloor(lots / step + 1.0e-8) * step;
   return(NormalizeDouble(lots, LotDigits()));
}

int LotDigits()
{
   double step = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(step >= 1.0) return(0);
   if(step >= 0.1) return(1);
   if(step >= 0.01) return(2);
   return(3);
}

//+------------------------------------------------------------------+
//| Daily loss protection                                            |
//+------------------------------------------------------------------+
int BrokerDayKey(const datetime value)
{
   return(TimeYear(value) * 1000 + TimeDayOfYear(value));
}

datetime BrokerDayStart(const datetime value)
{
   MqlDateTime parts;
   TimeToStruct(value, parts);
   parts.hour = 0;
   parts.min = 0;
   parts.sec = 0;
   return(StructToTime(parts));
}

double ClosedEAProfitSince(const datetime startTime)
{
   double result = 0.0;
   for(int i = OrdersHistoryTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;
      if(OrderCloseTime() < startTime)
         continue;
      result += OrderProfit() + OrderSwap() + OrderCommission();
   }
   return(result);
}

double FloatingEAProfit()
{
   double result = 0.0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;
      result += OrderProfit() + OrderSwap() + OrderCommission();
   }
   return(result);
}

void InitializeDailyRiskState()
{
   datetime now = TimeCurrent();
   g_dailyDayKey = BrokerDayKey(now);
   g_dailyStartTime = BrokerDayStart(now);
   g_dailyClosedProfit = ClosedEAProfitSince(g_dailyStartTime);
   g_dailyHistoryCount = OrdersHistoryTotal();
   g_dailyStartBalance = AccountBalance() - g_dailyClosedProfit;
   if(g_dailyStartBalance <= 0.0)
      g_dailyStartBalance = AccountBalance();
   g_dailyFloatingProfit = FloatingEAProfit();
   g_dailyNetResult = g_dailyClosedProfit + g_dailyFloatingProfit;
   g_dailyLossBlocked = false;

   if(EnableDailyLossLimit && g_dailyStartBalance > 0.0)
   {
      double maximumLoss = g_dailyStartBalance
                           * MaximumDailyLossPercent / 100.0;
      if(g_dailyNetResult <= -maximumLoss)
         g_dailyLossBlocked = true;
   }
}

void UpdateDailyLossProtection()
{
   datetime now = TimeCurrent();
   int currentKey = BrokerDayKey(now);
   if(currentKey != g_dailyDayKey)
   {
      // A new broker day resets the lock and establishes a fresh balance.
      g_dailyDayKey = currentKey;
      g_dailyStartTime = BrokerDayStart(now);
      g_dailyClosedProfit = ClosedEAProfitSince(g_dailyStartTime);
      g_dailyHistoryCount = OrdersHistoryTotal();
      g_dailyStartBalance = AccountBalance() - g_dailyClosedProfit;
      if(g_dailyStartBalance <= 0.0)
         g_dailyStartBalance = AccountBalance();
      g_dailyFloatingProfit = FloatingEAProfit();
      g_dailyNetResult = g_dailyFloatingProfit;
      g_dailyLossBlocked = false;
      g_status = "New broker day: daily loss lock reset";
   }

   int historyCount = OrdersHistoryTotal();
   if(historyCount != g_dailyHistoryCount)
   {
      g_dailyClosedProfit = ClosedEAProfitSince(g_dailyStartTime);
      g_dailyHistoryCount = historyCount;
   }
   g_dailyFloatingProfit = FloatingEAProfit();
   g_dailyNetResult = g_dailyClosedProfit + g_dailyFloatingProfit;

   if(!EnableDailyLossLimit || g_dailyStartBalance <= 0.0)
      return;

   if(g_dailyLossBlocked)
   {
      if(CloseAllEATradesAtDailyLimit && CountAllMagicPositions() > 0)
         CloseAllMagicPositions();
      return;
   }

   double maximumLoss = g_dailyStartBalance
                        * MaximumDailyLossPercent / 100.0;
   if(g_dailyNetResult <= -maximumLoss)
   {
      g_dailyLossBlocked = true;
      g_status = "DAILY LOSS LIMIT REACHED - entries locked";
      Print("RBS EA: daily loss limit reached. Start balance ",
            DoubleToString(g_dailyStartBalance, 2),
            ", daily result ", DoubleToString(g_dailyNetResult, 2),
            ", limit ", DoubleToString(maximumLoss, 2), ".");

      if(CloseAllEATradesAtDailyLimit)
      {
         CloseAllMagicPositions();
         g_dailyClosedProfit = ClosedEAProfitSince(g_dailyStartTime);
         g_dailyHistoryCount = OrdersHistoryTotal();
         g_dailyFloatingProfit = FloatingEAProfit();
         g_dailyNetResult = g_dailyClosedProfit + g_dailyFloatingProfit;
      }
   }
}

int CountAllMagicPositions()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() == OP_BUY || OrderType() == OP_SELL)
         count++;
   }
   return(count);
}

bool CloseAllMagicPositions()
{
   bool allClosed = true;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;

      string orderSymbol = OrderSymbol();
      int symbolDigits = (int)MarketInfo(orderSymbol, MODE_DIGITS);
      double closePrice = OrderType() == OP_BUY
                          ? MarketInfo(orderSymbol, MODE_BID)
                          : MarketInfo(orderSymbol, MODE_ASK);
      int ticket = OrderTicket();
      ResetLastError();
      bool closed = OrderClose(ticket, OrderLots(),
                               NormalizeDouble(closePrice, symbolDigits),
                               SlippagePoints, FailureColor);
      if(!closed)
      {
         allClosed = false;
         Print("RBS EA: daily-limit close failed for ticket ", ticket,
               ". Error ", GetLastError());
      }
   }
   return(allClosed);
}

//+------------------------------------------------------------------+
//| Step-based trailing stop                                         |
//| Starts after TrailingStartPoints profit, stays                    |
//| TrailingDistancePoints behind price, and moves in                 |
//| TrailingStepPoints increments.                                   |
//+------------------------------------------------------------------+
void ManageTrailingStops()
{
   if(!EnableTrailingStop)
      return;

   RefreshRates();
   double startDistance = TrailingStartPoints * Point;
   double requestedDistance = TrailingDistancePoints * Point;
   double stepDistance = TrailingStepPoints * Point;
   double brokerPoints = MarketInfo(Symbol(), MODE_STOPLEVEL);
   double freezePoints = MarketInfo(Symbol(), MODE_FREEZELEVEL);
   if(freezePoints > brokerPoints) brokerPoints = freezePoints;
   double brokerDistance = (brokerPoints + 2.0) * Point;
   double trailDistance = requestedDistance;
   if(trailDistance < brokerDistance) trailDistance = brokerDistance;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;

      double desiredStop = 0.0;
      bool shouldModify = false;

      if(OrderType() == OP_BUY)
      {
         double profitDistance = Bid - OrderOpenPrice();
         if(profitDistance < startDistance)
            continue;

         desiredStop = NormalizeDouble(Bid - trailDistance, Digits);
         // Never loosen an existing stop. After the first move, require
         // a full configured step before modifying again.
         if(OrderStopLoss() <= 0.0)
            shouldModify = (desiredStop > OrderOpenPrice());
         else
            shouldModify = (desiredStop > OrderStopLoss() + stepDistance
                            - Point * 0.1);
      }
      else
      {
         double profitDistance = OrderOpenPrice() - Ask;
         if(profitDistance < startDistance)
            continue;

         desiredStop = NormalizeDouble(Ask + trailDistance, Digits);
         if(OrderStopLoss() <= 0.0)
            shouldModify = (desiredStop < OrderOpenPrice());
         else
            shouldModify = (desiredStop < OrderStopLoss() - stepDistance
                            + Point * 0.1);
      }

      if(!shouldModify || desiredStop <= 0.0)
         continue;

      int ticket = OrderTicket();
      ResetLastError();
      bool modified = OrderModify(ticket, OrderOpenPrice(), desiredStop,
                                  OrderTakeProfit(), 0,
                                  OrderType() == OP_BUY
                                  ? ProBullColor : ProBearColor);
      if(modified)
      {
         g_status = "Trailing stop moved: ticket "
                    + IntegerToString(ticket) + " to "
                    + DoubleToString(desiredStop, Digits);
      }
      else
      {
         int error = GetLastError();
         if(error != 1)
            Print("RBS EA: trailing OrderModify failed for ticket ",
                  ticket, ". Error ", error,
                  ", requested SL ", DoubleToString(desiredStop, Digits));
      }
   }
}

