void DeleteObjectIfExists(const string name)
{
   if(ObjectFind(0, name) >= 0)
      ObjectDelete(0, name);
}

void DeleteEAObjects()
{
   if(g_objectPrefix != "")
      DeleteObjectsWithPrefix(g_objectPrefix);
}

void DeleteObjectsWithPrefix(const string prefix)
{
   int total = ObjectsTotal(0, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i, 0, -1);
      if(StringFind(name, prefix, 0) == 0)
         ObjectDelete(0, name);
   }
}

color BlendColor(const color foreground,
                 const color background,
                 const double opacity)
{
   int fg = (int)foreground;
   int bg = (int)background;
   int fr = fg & 255;
   int fgreen = (fg >> 8) & 255;
   int fb = (fg >> 16) & 255;
   int br = bg & 255;
   int bgreen = (bg >> 8) & 255;
   int bb = (bg >> 16) & 255;
   int r = (int)MathRound(fr * opacity + br * (1.0 - opacity));
   int g = (int)MathRound(fgreen * opacity + bgreen * (1.0 - opacity));
   int b = (int)MathRound(fb * opacity + bb * (1.0 - opacity));
   return((color)(r | (g << 8) | (b << 16)));
}

int DaysInMonth(const int year, const int month)
{
   if(month == 2)
   {
      bool leap = ((year % 400) == 0 ||
                  ((year % 4) == 0 && (year % 100) != 0));
      return(leap ? 29 : 28);
   }
   if(month == 4 || month == 6 || month == 9 || month == 11)
      return(30);
   return(31);
}

datetime SubtractCalendarMonths(const datetime source, const int months)
{
   MqlDateTime parts;
   TimeToStruct(source, parts);
   int year = parts.year;
   int month = parts.mon - months;
   while(month <= 0)
   {
      month += 12;
      year--;
   }
   parts.year = year;
   parts.mon = month;
   int maximumDay = DaysInMonth(year, month);
   if(parts.day > maximumDay) parts.day = maximumDay;
   return(StructToTime(parts));
}

