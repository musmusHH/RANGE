void DrawOutcomeMarker(const datetime signalTime,
                       const int resultShift,
                       const int direction,
                       const bool success)
{
   if(!ShowOutcomeMarkers || !ShowChartObjects ||
      !VisualOutputAvailable())
      return;

   datetime resultTime = iTime(NULL, 0, resultShift);
   string base = g_objectPrefix + "RESULT_"
                 + IntegerToString((int)signalTime);
   double atr = iATR(NULL, 0, SignalATRPeriod, resultShift);
   double gap = atr * 0.25;
   if(gap <= 0.0) gap = MathMax(iHigh(NULL, 0, resultShift)
                                  - iLow(NULL, 0, resultShift),
                                  Point * 10) * 0.20;
   double price = direction > 0
                  ? iLow(NULL, 0, resultShift) - gap
                  : iHigh(NULL, 0, resultShift) + gap;
   color resultColor = success ? SuccessColor : FailureColor;

   SetArrowObject(base + "_ICON", resultTime, price,
                  success ? 252 : 251, resultColor, 2);
   // No chart wording: the result icon alone marks the outcome.
   PurgeAnnotationText(base);
}

void SetPriceRectangle(const string name,
                       const datetime leftTime,
                       const double top,
                       const datetime rightTime,
                       const double bottom,
                       const color objectColor,
                       const bool inBackground)
{
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_RECTANGLE, 0,
                   leftTime, top, rightTime, bottom);
   ObjectMove(0, name, 0, leftTime, top);
   ObjectMove(0, name, 1, rightTime, bottom);
   ObjectSetInteger(0, name, OBJPROP_COLOR, objectColor);
   ObjectSetInteger(0, name, OBJPROP_FILL, true);
   ObjectSetInteger(0, name, OBJPROP_BACK, inBackground);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_SELECTED, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

void SetPriceTrend(const string name,
                   const datetime time1,
                   const double price1,
                   const datetime time2,
                   const double price2,
                   const color lineColor,
                   const int style,
                   const int width)
{
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_TREND, 0, time1, price1, time2, price2);
   ObjectMove(0, name, 0, time1, price1);
   ObjectMove(0, name, 1, time2, price2);
   ObjectSetInteger(0, name, OBJPROP_COLOR, lineColor);
   ObjectSetInteger(0, name, OBJPROP_STYLE, style);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, width);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

void SetArrowObject(const string name,
                    const datetime objectTime,
                    const double objectPrice,
                    const int arrowCode,
                    const color arrowColor,
                    const int width)
{
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_ARROW, 0, objectTime, objectPrice);
   ObjectMove(0, name, 0, objectTime, objectPrice);
   ObjectSetInteger(0, name, OBJPROP_ARROWCODE, arrowCode);
   ObjectSetInteger(0, name, OBJPROP_COLOR, arrowColor);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, width);
   // Keep price annotations behind the raised screen panels so breakout
   // labels and result icons never print over the dashboard cards.
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

void SetPriceText(const string name,
                  const datetime objectTime,
                  const double objectPrice,
                  const string text,
                  const color textColor,
                  const int fontSize)
{
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_TEXT, 0, objectTime, objectPrice);
   ObjectMove(0, name, 0, objectTime, objectPrice);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetString(0, name, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, name, OBJPROP_COLOR, textColor);
   ObjectSetInteger(0, name, OBJPROP_ANCHOR, ANCHOR_CENTER);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

