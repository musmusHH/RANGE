void ChangePanelStyle(const int direction)
{
   g_activePanelStyle += direction;
   if(g_activePanelStyle > 9) g_activePanelStyle = 0;
   if(g_activePanelStyle < 0) g_activePanelStyle = 9;

   if(RememberPanelStyleSelection && g_panelStyleMemoryKey != "")
      GlobalVariableSet(g_panelStyleMemoryKey, (double)g_activePanelStyle);

   ConfigurePanelStyle();

   // Remove mode-specific section stripes that are not used by every style.
   string sections[6];
   sections[0] = "SEC_ACCOUNT";
   sections[1] = "SEC_RISK";
   sections[2] = "SEC_SIGNAL";
   sections[3] = "SEC_FILTER";
   sections[4] = "SEC_EQUITY";
   sections[5] = "SEC_RESULT";
   for(int i = 0; i < 6; i++)
      DeleteObjectIfExists(g_objectPrefix + sections[i] + "_ACCENT");

   g_lastTrackerHistoryCount = -1;
   g_lastResultCardHistoryCount = -1;
   g_lastDashboardUpdate = 0;
   g_lastDashboardStatus = "";
   UpdateStatusDisplay();
   ChartRedraw(0);
}

