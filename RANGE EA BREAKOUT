   return(shift <= VisualHistoryBars);
}

void DrawRangeZone(const string baseName,
                   const datetime leftTime,
                   const datetime rightTime,
                   const double top,
                   const double bottom)
{
   if(!ShowChartObjects || !VisualOutputAvailable() ||
      baseName == "" || top <= bottom)
      return;

   double middle = (top + bottom) * 0.5;
   double height = top - bottom;

   // Neutral blue body with a gold accent frame. Everything stays behind
   // the candles; the 3D feel comes from the offset shadow plus the
   // light/dark bevel edges rather than from stacking objects on top.
   double fillOpacity = RangeZoneFillOpacity;
   if(fillOpacity < 0.02) fillOpacity = 0.02;
   if(fillOpacity > 0.85) fillOpacity = 0.85;

   color bodyColor  = BlendColor(RangeZoneFillColor,
                                 ProBackgroundColor, fillOpacity);
   color upperColor = BlendColor(RangeZoneFillColor,
                                 ProBackgroundColor, fillOpacity * 1.45);
   color lowerColor = BlendColor(RangeZoneFillColor,
                                 ProBackgroundColor, fillOpacity * 0.70);
   color bevelLight = BlendColor(RangeZoneAccentColor,
                                 ProBackgroundColor, 0.85);
   color bevelDark  = BlendColor(RangeZoneShadowColor,
                                 RangeZoneFillColor, 0.75);
   color shadowColor = BlendColor(RangeZoneShadowColor,
                                  ProBackgroundColor, 0.55);
   color midColor = BlendColor(RangeZoneAccentColor,
                               ProBackgroundColor, 0.38);

   int borderWidth = RangeZoneBorderWidth;
   if(borderWidth < 1) borderWidth = 1;
   if(borderWidth > 5) borderWidth = 5;

   // ---- drop shadow (offset down/right) for the raised illusion --------
   if(RangeZoneRaised3D)
   {
      int offBars = RangeZoneShadowOffsetBars;
      if(offBars < 0) offBars = 0;
      double offPrice = height * RangeZoneShadowOffsetATR;
      if(offPrice <= 0.0) offPrice = Point * 10;

      datetime shadowLeft  = ShiftTimeByBars(leftTime, offBars);
      datetime shadowRight = ShiftTimeByBars(rightTime, offBars);

      SetPriceRectangle(baseName + "_SHADOW", shadowLeft,
                        top - offPrice, shadowRight,
                        bottom - offPrice, shadowColor, true);
   }
   else
      DeleteObjectIfExists(baseName + "_SHADOW");

   // ---- main body: light on top, darker below = embossed slab ----------
   SetPriceRectangle(baseName + "_BODY", leftTime, top, rightTime,
                     bottom, bodyColor, true);
   SetPriceRectangle(baseName + "_UP", leftTime, top, rightTime,
                     middle, upperColor, true);
   SetPriceRectangle(baseName + "_DN", leftTime, middle, rightTime,
                     bottom, lowerColor, true);

   // ---- gold frame ------------------------------------------------------
   SetPriceTrend(baseName + "_TOP", leftTime, top, rightTime, top,
                 RangeZoneAccentColor, STYLE_SOLID, borderWidth);
   SetPriceTrend(baseName + "_BOTTOM", leftTime, bottom,
                 rightTime, bottom, RangeZoneAccentColor,
                 STYLE_SOLID, borderWidth);

   // ---- bevel highlights: bright just under the top edge, dark just
   //      above the bottom edge -> surface appears lifted ---------------
   if(RangeZoneRaised3D && height > 0.0)
   {
      double inset = height * 0.06;
      SetPriceTrend(baseName + "_BEVEL_HI", leftTime, top - inset,
                    rightTime, top - inset, bevelLight, STYLE_SOLID, 1);
      SetPriceTrend(baseName + "_BEVEL_LO", leftTime, bottom + inset,
                    rightTime, bottom + inset, bevelDark, STYLE_SOLID, 1);
   }
   else
   {
      DeleteObjectIfExists(baseName + "_BEVEL_HI");
      DeleteObjectIfExists(baseName + "_BEVEL_LO");
   }

   // ---- equilibrium midline --------------------------------------------
   if(RangeZoneShowMidline)
      SetPriceTrend(baseName + "_MID", leftTime, middle, rightTime,
                    middle, midColor, STYLE_DOT, 1);
   else
      DeleteObjectIfExists(baseName + "_MID");

   // ---- vertical accent marking where the range was formed -------------
   if(RangeZoneShowLeftEdge)
      SetPriceTrend(baseName + "_EDGE", leftTime, top, leftTime,
                    bottom, RangeZoneAccentColor, STYLE_SOLID, 1);
   else
      DeleteObjectIfExists(baseName + "_EDGE");
}

//+------------------------------------------------------------------+
//| Shift a chart time by a whole number of bars (period safe)       |
//+------------------------------------------------------------------+
datetime ShiftTimeByBars(const datetime base, const int bars)
{
   if(bars == 0) return(base);
   return((datetime)(base + (long)bars * PeriodSeconds(_Period)));
}

void DrawBreakoutArrow(const datetime signalTime,
                       const int shift,
                       const int direction,
                       const double rangeTop,
                       const double rangeBottom,
                       const bool live)
{
   if(!ShowChartObjects || !VisualOutputAvailable())
      return;

   string key = live ? g_objectPrefix + "LIVE_SIGNAL"
                     : g_objectPrefix + "SIGNAL_"
                       + IntegerToString((int)signalTime);
   double atr = iATR(NULL, 0, SignalATRPeriod, shift);
   double gap = atr * 0.16;
   if(gap <= 0.0) gap = MathMax(iHigh(NULL, 0, shift)
                                  - iLow(NULL, 0, shift), Point * 10) * 0.15;
   double price = direction > 0
                  ? iLow(NULL, 0, shift) - gap
                  : iHigh(NULL, 0, shift) + gap;
   color arrowColor = direction > 0 ? ProBullColor : ProBearColor;

   SetArrowObject(key + "_ARROW", signalTime, price,
                  direction > 0 ? 233 : 234, arrowColor, 2);

   // No chart wording: the arrow alone marks the breakout.
   PurgeAnnotationText(key);
}

