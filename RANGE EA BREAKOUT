//+------------------------------------------------------------------+
void UpdateStatusDisplay()
{
   if(!VisualOutputAvailable())
      return;
   if(!ShowEAStatus && !ShowProfitTracker && !ShowClosedTradeResultCards)
      return;

   datetime updateTime = TimeCurrent();
   if(updateTime == g_lastDashboardUpdate &&
      g_status == g_lastDashboardStatus)
      return;
   g_lastDashboardUpdate = updateTime;
   g_lastDashboardStatus = g_status;

   RefreshRates();
   if(Bars > 1)
   {
      g_analysisEnd = TimeCurrent();
      int months = AnalysisMonths;
      if(months < 1) months = 1;
      g_analysisStart = SubtractCalendarMonths(g_analysisEnd, months);
   }
   RecalculateOutcomeStatistics();
   if(ShowEAStatus)
      DrawMainControlPanel();
   if(ShowProfitTracker)
      DrawProfitTrackerCard();
   if(ShowClosedTradeResultCards)
      DrawClosedTradeResultCards();
}

void DrawMainControlPanel()
{
   if(UseFuturisticDashboard)
   {
      DrawFuturisticPanel();
      return;
   }
   int x = DashboardX;
   int y = DashboardY;
   int width = 400;
   int height = 610;
   DrawRaisedCard(g_objectPrefix + "MAIN_CARD", x, y, width, height,
